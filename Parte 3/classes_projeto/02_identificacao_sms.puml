@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam wrapWidth 260
skinparam nodesep 45
skinparam ranksep 60
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam class {
 BackgroundColor<<boundary>> #EAF2FC
 BackgroundColor<<control>> #FFF6DF
 BackgroundColor<<entity>> #EEF6ED
 BackgroundColor<<collection>> #F1EAF9
 BackgroundColor<<datatype>> #F7F7F7
 BackgroundColor<<externalSystem>> #FFF0EB
 BorderColor #486553
 ArrowColor #486553
}
hide empty members
header Serviço de Assinaturas de Marmitas • Projeto de Software
title <b>Classes de projeto — I02: Identificação e confirmação SMS</b>
footer 02 • Recorte do mesmo modelo de projeto; membros de outros cenários estão omitidos.
package "Apresentação" #EAF2FC {
class TelaAssinatura <<boundary>> {
  -controle: ControladorAssinatura
  --
  +informarIdentificacao(celular: String, nome: String, email: String): void
  +solicitarCodigo(): void
  +apresentarValidacaoSMS(): void
  +reenviarCodigo(): void
  +informarCodigo(codigoInformado: String): void
  +liberarSelecaoDePlano(): void
  +informarErroCodigo(): void
  +solicitarNovaTentativaOuReenvio(): void
}
}
package "Coordenação" #FFF6DF {
class ControladorAssinatura <<control>> {
  -tela: TelaAssinatura
  -assinante: Assinante [0..1]
  -codigo: CodigoConfirmacao [0..1]
  -celularConfirmado: Boolean = false
  -mensageria: InterfaceMensageria
  --
  +identificarAssinante(celular: String, nome: String, email: String): Assinante
  +reenviarCodigo(): void
  +confirmarCelular(codigoInformado: String): Boolean
}
}
package "Domínio" #EEF6ED {
class Assinante <<entity>> {
  -celular: String
  -nome: String
  -email: String
  --
  +Assinante(celular: String, nome: String, email: String)
  +associarCodigoConfirmacao(codigo: CodigoConfirmacao): void
}
class CodigoConfirmacao <<entity>> {
  -codigo: String
  -tentativas: Integer = 0
  -expiraEm: DateTime
  --
  +CodigoConfirmacao(validade: Duration)
  +gerarNovoCodigo(validade: Duration): String
  +validar(codigoInformado: String, instanteAtual: DateTime): Boolean
  +registrarTentativaSemSucesso(): void
  +obterCodigo(): String
}
}
package "Integrações" #FFF0EB {
class InterfaceMensageria <<boundary>> {
  +enviarSMS(celular: String, codigo: String): void
}
class ServicoMensageria <<externalSystem>> {
  +enviarSMS(celular: String, codigo: String): void
}
}
TelaAssinatura "1" <--> "1" ControladorAssinatura : interage >
ControladorAssinatura "0..1" --> "0..1" Assinante : identifica >
ControladorAssinatura "0..1" --> "0..1" CodigoConfirmacao : valida >
Assinante "1" --> "0..1" CodigoConfirmacao : recebe >
ControladorAssinatura "0..*" --> "1" InterfaceMensageria : solicita SMS >
InterfaceMensageria ..> ServicoMensageria : envia SMS >
note bottom of CodigoConfirmacao
expiraEm permite verificar a validade de 5 minutos.
Reenvio substitui o código e sua expiração.
Não há máximo de tentativas especificado.
end note
note bottom of Assinante
nome e email foram acrescentados conforme as telas.
Código pode estar ausente antes de sua geração.
end note
legend bottom left
  - privado | + público | NomeClasse(...): construtor
  Linha contínua: associação navegável; tracejada: dependência
  Losango preenchido: composição; vazio: agregação
  > no rótulo: sentido de leitura; números: multiplicidades
endlegend
@enduml
